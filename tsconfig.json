{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/origin/*": ["registry/default/*"],
      "@/registry/default/ui/*": [
        "components/*",
        "registry/default/ui/*"
      ],
      "@coss/ui/components/*": [
        "components/*"
      ],
      "@/components/ui/*": [
        "components/*"
      ],
      "@/registry/default/lib/*": ["lib/*"],
      "@coss/ui/lib/*": ["lib/*"],
      "@/lib/*": ["lib/*"],
      "@/registry/default/hooks/*": ["hooks/*"],
      "@/hooks/*": ["hooks/*"],
      "@coss/ui/*": ["*"],
      "@/*": ["src/*", "*"]
    }
  },
  "include": ["src", "components", "lib", "hooks", "base-ui", "registry"]
}
