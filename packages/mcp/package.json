{
  "name": "coss-ui-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Coss UI component library and particle examples",
  "type": "module",
  "bin": {
    "coss-ui-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:data": "node scripts/bundle-data.mjs",
    "build:ts": "tsup",
    "build": "npm run build:data && npm run build:ts",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "node test/test-server.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coss-ui",
    "shadcn",
    "components",
    "ui-library",
    "react",
    "tailwindcss",
    "ai-agent"
  ],
  "author": "Sheikh Shariar Nehal",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
